datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  balance      Float    @default(1000.00)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
