datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
}

enum DepositStatus {
  PENDING
  COMPLETED
  FAILED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum PromoWagerStatus {
  WAITING_DEPOSIT
  WAGERING
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role                UserRole @default(USER)
  /** @deprecated Синхронизируется с суммой трёх кошельков; для отображения используйте balances. */
  balance             Float    @default(0)
  balanceCash         Float    @default(0)
  balanceBonus        Float    @default(0)
  balancePromoDeposit Float    @default(0)
  createdAt           DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deposits             Deposit[]
  withdrawals          WithdrawalRequest[]
  ledger               BalanceLedger[]
  promoActivations     PromoActivation[]
  processedWithdrawals WithdrawalRequest[] @relation("WithdrawalProcessor")
  bigWins              BigWin[]
}

model Deposit {
  id          String        @id @default(cuid())
  userId      String
  amount      Float
  bonusAmount Float         @default(0)
  currency    String        @default("RUB")
  status      DepositStatus @default(PENDING)
  provider    String        @default("yoomoney")
  label       String        @unique
  externalId  String?       @unique
  promoCodeId String?
  createdAt   DateTime      @default(now())
  completedAt DateTime?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCode       PromoCode?       @relation(fields: [promoCodeId], references: [id])
  promoActivation PromoActivation?

  @@index([userId, createdAt])
  @@index([status])
}

model WithdrawalRequest {
  id            String           @id @default(cuid())
  userId        String
  amount        Float
  payoutTo      String
  status        WithdrawalStatus @default(PENDING)
  userNote      String?
  adminNote     String?
  processedById String?
  createdAt     DateTime         @default(now())
  processedAt   DateTime?

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  processedBy User? @relation("WithdrawalProcessor", fields: [processedById], references: [id])

  @@index([userId, createdAt])
  @@index([status])
}

model PromoCode {
  id                  String    @id @default(cuid())
  code                String    @unique
  depositBonusPercent Float
  wagerMultiplier     Float
  maxUses             Int?
  usedCount           Int       @default(0)
  active              Boolean   @default(true)
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())

  activations PromoActivation[]
  deposits    Deposit[]
}

model PromoActivation {
  id            String           @id @default(cuid())
  userId        String
  promoCodeId   String
  status        PromoWagerStatus @default(WAITING_DEPOSIT)
  depositId     String?          @unique
  depositAmount Float            @default(0)
  bonusAmount   Float            @default(0)
  wagerRequired Float            @default(0)
  wagerProgress Float            @default(0)
  createdAt     DateTime         @default(now())
  appliedAt     DateTime?
  completedAt   DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCode PromoCode  @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  deposit   Deposit?   @relation(fields: [depositId], references: [id])

  @@unique([promoCodeId, userId])
  @@index([userId, status])
}

model BalanceLedger {
  id           String   @id @default(cuid())
  userId       String
  amount       Float
  balanceAfter Float
  type         String
  refId        String?
  note         String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
}

model BigWin {
  id         String   @id @default(cuid())
  userId     String
  game       String   @default("xboot")
  gameTitle  String   @default("Red Devil")
  bet        Float
  win        Float
  multiplier Float
  bookSeed   String?
  bookIndex  Int?
  scatterBuy Int      @default(0)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([game, multiplier, createdAt])
  @@index([userId, game, multiplier, createdAt])
  @@index([game, win, createdAt])
}
