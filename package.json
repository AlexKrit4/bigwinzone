{
  "name": "rave-casino",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "books-server": "node books-server.js",
    "xboot-books-server": "node xboot-books-server.js",
    "xboot-books": "node generate-xboot-books.js",
    "xboot-books-v2": "node generate-xboot-books-v2.js",
    "xboot-books-v2-full": "node generate-xboot-books-v2.js --full",
    "xboot-buy-books": "node generate-xboot-buy-books.js",
    "xboot-buy-books-v2": "node generate-xboot-buy-books-v2.js",
    "xboot-buy-books-v2-3": "node generate-xboot-buy-books-v2.js --buy3",
    "xboot-buy-books-v2-4": "node generate-xboot-buy-books-v2.js --buy4",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "set-admin": "node scripts/set-admin.mjs",
    "check-yoomoney": "node scripts/check-yoomoney-env.mjs",
    "deploy:prod": "prisma generate && rm -rf .next && next build"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "latest",
    "jsonwebtoken": "latest",
    "next": "latest",
    "prisma": "^6.19.3",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/bcryptjs": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "typescript": "latest"
  }
}
